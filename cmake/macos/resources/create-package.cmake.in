make_directory("$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/package/Library/Application Support/obs-studio/plugins")

if(
  EXISTS "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_PROJECT_NAME@.plugin"
  AND NOT IS_SYMLINK "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_PROJECT_NAME@.plugin"
)
  file(
    INSTALL
    DESTINATION "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/package/Library/Application Support/obs-studio/plugins"
    TYPE
    DIRECTORY
    FILES
    "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_PROJECT_NAME@.plugin"
    USE_SOURCE_PERMISSIONS
  )
endif()

execute_process(
  COMMAND /usr/bin/find "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/package" "(" -name ".DS_Store" -o -name "._*" ")" -delete
  COMMAND_ERROR_IS_FATAL ANY
)

execute_process(COMMAND /usr/bin/xattr -cr "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/package" COMMAND_ERROR_IS_FATAL ANY)

make_directory("$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/temp")

execute_process(
  COMMAND
    "${CMAKE_COMMAND}" -E env COPYFILE_DISABLE=1 /usr/bin/pkgbuild --identifier @MACOS_BUNDLEID@ --version
    @CMAKE_PROJECT_VERSION@ --root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/package" --component-plist
    "@CMAKE_CURRENT_BINARY_DIR@/installer-component.plist" --scripts "@CMAKE_CURRENT_BINARY_DIR@/installer-scripts"
    "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/temp/@CMAKE_PROJECT_NAME@.pkg"
  COMMAND_ERROR_IS_FATAL ANY
)

execute_process(
  COMMAND
    "${CMAKE_COMMAND}" -E env COPYFILE_DISABLE=1 /usr/bin/productbuild --distribution
    "@CMAKE_CURRENT_BINARY_DIR@/distribution" --package-path "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/temp" --resources
    "@CMAKE_CURRENT_BINARY_DIR@/installer-resources" "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_PROJECT_NAME@.pkg"
  COMMAND_ERROR_IS_FATAL ANY
)

if(EXISTS "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_PROJECT_NAME@.pkg")
  file(REMOVE_RECURSE "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/temp")
  file(REMOVE_RECURSE "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/package")
endif()
