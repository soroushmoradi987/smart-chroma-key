<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <style>
    body { font: -apple-system-body; color: #1f2937; }
    h1 { font: -apple-system-title1; margin-bottom: 0.4em; }
    .accent { color: #167d4b; font-weight: 600; }
  </style>
</head>
<body>
  <h1>Install @PLUGIN_DISPLAY_NAME@</h1>
  <p>This wizard installs version @CMAKE_PROJECT_VERSION@ for OBS Studio on Apple silicon and Intel Macs.</p>
  <p>Select <span class="accent">Green Screen</span> or <span class="accent">Blue Screen</span> from the filter settings after installation.</p>
  <p>Please close OBS Studio before continuing.</p>
</body>
</html>
