uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 texel_size;
uniform int ScreenType = 0;

// ==========================================
// 1. Chroma Key
// ==========================================
uniform float4 KeyColor <
    string name = "Key Color";
    string field_type = "color";
> = {0.0, 1.0, 0.0, 1.0};

uniform float BaseKey <
    string name = "Chroma Threshold";
    string field_type = "slider";
    float minimum = -0.5;
    float maximum = 1.0;
    float step = 0.001;
> = 0.0;

uniform float EdgeSoftness <
    string name = "Edge Softness";
    string field_type = "slider";
    float minimum = 0.001;
    float maximum = 1.0;
    float step = 0.001;
> = 0.05;

uniform float BackgroundClean <
    string name = "Clean Noise";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.001;
> = 0.0;

// ==========================================
// 2. Hair Detail Recovery
// ==========================================
uniform float HairDetail <
    string name = "Hair Detail";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform float HairSoftness <
    string name = "Hair Softness";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

// ==========================================
// 3. Edge Refinement
// ==========================================
uniform float EdgeBlur <
    string name = "Edge Blur";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 5.0;
    float step = 0.1;
> = 0.0;

uniform float EdgeShrink <
    string name = "Edge Shrink";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform float EdgeGrow <
    string name = "Edge Grow";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

// ==========================================
// 4. Despill & Hair Color
// ==========================================
uniform float4 HairColor <
    string name = "Hair Color";
    string field_type = "color";
> = {0.2, 0.1, 0.05, 1.0};

uniform float SpillReduction <
    string name = "Despill";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.0;

uniform float DespillLight <
    string name = "Despill Light Areas";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.0;

uniform float DespillDark <
    string name = "Despill Dark Areas";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.0;

uniform float ColorInjectStrength <
    string name = "Color Boost";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 5.0;
    float step = 0.01;
> = 0.0;

// ==========================================
// 5. Color Correction
// ==========================================
uniform float Brightness <
    string name = "Brightness";
    string field_type = "slider";
    float minimum = -1.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform float Contrast <
    string name = "Contrast";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.0;

uniform float Saturation <
    string name = "Saturation";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.0;

uniform float Gamma <
    string name = "Gamma";
    string field_type = "slider";
    float minimum = 0.1;
    float maximum = 3.0;
    float step = 0.01;
> = 1.0;

uniform float Temperature <
    string name = "Temperature";
    string field_type = "slider";
    float minimum = -1.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform float Tint <
    string name = "Tint";
    string field_type = "slider";
    float minimum = -1.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

// ==========================================
// 6. Key Processing
// ==========================================
uniform float KeySatBoost <
    string name = "Key Saturation Boost";
    string field_type = "slider";
    float minimum = 1.0;
    float maximum = 5.0;
    float step = 0.01;
> = 1.0;

// ==========================================
// 7. Opacity
// ==========================================
uniform float Opacity <
    string name = "Opacity";
    string field_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

sampler_state def_sampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in) {
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

// Saturation is boosted only in the analysis path. Output colors are untouched.
float3 boost_sat(float3 rgb, float amount) {
    float l = dot(rgb, float3(0.2126, 0.7152, 0.0722));
    return lerp(float3(l, l, l), rgb, amount);
}

// 0 = green, 1 = blue. Auto detection is resolved on the CPU before rendering.
float screen_difference(float3 rgb) {
    if (ScreenType == 1) {
        return rgb.b - max(rgb.r, rgb.g);
    }
    return rgb.g - max(rgb.r, rgb.b);
}

// RGB chromaticity removes most brightness variation caused by folds, shadows,
// or uneven lamps while retaining the hue difference between screen and subject.
float3 chromaticity(float3 rgb) {
    float sum = max(rgb.r + rgb.g + rgb.b, 0.001);
    return rgb / sum;
}

float chroma_distance_squared_to_key(float3 rgb) {
    float3 sample_chroma = chromaticity(max(boost_sat(rgb, KeySatBoost), float3(0.0, 0.0, 0.0)));
    float3 key_chroma = chromaticity(max(boost_sat(KeyColor.rgb, KeySatBoost), float3(0.0, 0.0, 0.0)));
    float3 delta = sample_chroma - key_chroma;
    return dot(delta, delta);
}

float chroma_distance_to_key(float3 rgb) {
    return sqrt(chroma_distance_squared_to_key(rgb));
}

float screen_confidence(float3 rgb) {
    float3 boosted = boost_sat(rgb, KeySatBoost);
    float tolerance = max(BaseKey, 0.002);
    float softness = max(EdgeSoftness, 0.002);
    float outer_tolerance = tolerance + softness;
    float distance_squared = chroma_distance_squared_to_key(rgb);
    float hue_match = 1.0 - smoothstep(tolerance * tolerance,
                                       outer_tolerance * outer_tolerance,
                                       distance_squared);

    float key_difference = max(screen_difference(boost_sat(KeyColor.rgb, KeySatBoost)), 0.02);
    float dominance = screen_difference(boosted);
    float dominance_match = smoothstep(-0.01, max(0.012, key_difference * 0.12), dominance);

    float maximum = max(boosted.r, max(boosted.g, boosted.b));
    float minimum = min(boosted.r, min(boosted.g, boosted.b));
    float colorfulness = smoothstep(0.01, 0.055, maximum - minimum);
    return saturate(hue_match * dominance_match * colorfulness);
}

float compute_core_alpha(float4 c) {
    return saturate(1.0 - screen_confidence(c.rgb));
}

// Kept for the legacy reference path below; the active technique uses the
// structured fractional-hair matte in PSAdaptiveKey.
float compute_hair_alpha(float4 c) {
    return compute_core_alpha(c);
}

float4 PSUltimateKey(VertData v_in) : TARGET {
    float4 color = image.Sample(def_sampler, v_in.uv);

    // 1. Core alpha
    float core_alpha = compute_core_alpha(color);

    float hair_alpha = 0.0;

    // Hair analysis is the expensive path, so skip its eight texture samples
    // completely when hair recovery is disabled.
    if (HairDetail > 0.001) {
        // 2. Advanced Hair Recovery: Screen Subtraction + 8-Neighbor Structure Analysis
        //
        // Technique: Combines Ultimatte-style screen subtraction for natural partial
        // transparency with neighbor analysis to detect thin structures (hair strands).
        //
        // Screen Subtraction: pixel = foreground * alpha + screen * (1-alpha)
        // Solving: alpha = 1 - (pixel_screen_diff / sampled_screen_diff)
        //
        // Neighbor Analysis: if surrounding pixels are screen but this pixel
        // is darker/different, it's a thin foreground element (hair strand).

        float3 cb = boost_sat(color.rgb, KeySatBoost);
        float c_gd = screen_difference(cb);
        float c_luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));

        // --- Screen Subtraction Alpha ---
        float3 kb = boost_sat(KeyColor.rgb, KeySatBoost);
        float key_gd = max(screen_difference(kb), 0.01);
        float screen_sub_alpha = 1.0 - saturate(c_gd / key_gd);

        // --- 8-Neighbor Structure Analysis (1px distance) ---
        float neighbor_screen_sum = 0.0;
        float neighbor_luma_sum = 0.0;
        float thresh = max(BaseKey, 0.0) + EdgeSoftness * 0.3;
        float3 nb;
        float ngd;

        // Left
        nb = boost_sat(image.Sample(def_sampler, v_in.uv + float2(-1.0, 0.0) * texel_size).rgb, KeySatBoost);
        ngd = screen_difference(nb);
        neighbor_screen_sum += smoothstep(thresh * 0.5, thresh, ngd);
        neighbor_luma_sum += dot(nb, float3(0.2126, 0.7152, 0.0722));

        // Right
        nb = boost_sat(image.Sample(def_sampler, v_in.uv + float2(1.0, 0.0) * texel_size).rgb, KeySatBoost);
        ngd = screen_difference(nb);
        neighbor_screen_sum += smoothstep(thresh * 0.5, thresh, ngd);
        neighbor_luma_sum += dot(nb, float3(0.2126, 0.7152, 0.0722));

        // Up
        nb = boost_sat(image.Sample(def_sampler, v_in.uv + float2(0.0, -1.0) * texel_size).rgb, KeySatBoost);
        ngd = screen_difference(nb);
        neighbor_screen_sum += smoothstep(thresh * 0.5, thresh, ngd);
        neighbor_luma_sum += dot(nb, float3(0.2126, 0.7152, 0.0722));

        // Down
        nb = boost_sat(image.Sample(def_sampler, v_in.uv + float2(0.0, 1.0) * texel_size).rgb, KeySatBoost);
        ngd = screen_difference(nb);
        neighbor_screen_sum += smoothstep(thresh * 0.5, thresh, ngd);
        neighbor_luma_sum += dot(nb, float3(0.2126, 0.7152, 0.0722));

        // Top-Left
        nb = boost_sat(image.Sample(def_sampler, v_in.uv + float2(-1.0, -1.0) * texel_size).rgb, KeySatBoost);
        ngd = screen_difference(nb);
        neighbor_screen_sum += smoothstep(thresh * 0.5, thresh, ngd);
        neighbor_luma_sum += dot(nb, float3(0.2126, 0.7152, 0.0722));

        // Top-Right
        nb = boost_sat(image.Sample(def_sampler, v_in.uv + float2(1.0, -1.0) * texel_size).rgb, KeySatBoost);
        ngd = screen_difference(nb);
        neighbor_screen_sum += smoothstep(thresh * 0.5, thresh, ngd);
        neighbor_luma_sum += dot(nb, float3(0.2126, 0.7152, 0.0722));

        // Bottom-Left
        nb = boost_sat(image.Sample(def_sampler, v_in.uv + float2(-1.0, 1.0) * texel_size).rgb, KeySatBoost);
        ngd = screen_difference(nb);
        neighbor_screen_sum += smoothstep(thresh * 0.5, thresh, ngd);
        neighbor_luma_sum += dot(nb, float3(0.2126, 0.7152, 0.0722));

        // Bottom-Right
        nb = boost_sat(image.Sample(def_sampler, v_in.uv + float2(1.0, 1.0) * texel_size).rgb, KeySatBoost);
        ngd = screen_difference(nb);
        neighbor_screen_sum += smoothstep(thresh * 0.5, thresh, ngd);
        neighbor_luma_sum += dot(nb, float3(0.2126, 0.7152, 0.0722));

        float surround_screen = neighbor_screen_sum * 0.125;
        float avg_neighbor_luma = neighbor_luma_sum * 0.125;

        // --- Hair Strand Detection ---
        // Local contrast: hair strands are darker than the surrounding screen
        float darkness_contrast = saturate((avg_neighbor_luma - c_luma) * 3.0);

        // Has screen contamination (mixed with screen) but is not pure screen
        float has_screen_mix = smoothstep(-0.02, 0.05, c_gd);
        float is_clearly_screen = smoothstep(thresh * 0.5, thresh * 0.9, c_gd);

        // Hair score via local contrast: surrounded by screen + darker
        float hair_by_contrast = surround_screen * darkness_contrast * has_screen_mix * (1.0 - is_clearly_screen);

        // Hair score via pure darkness: very dark pixel near screen
        float very_dark = smoothstep(HairSoftness * 0.4 + 0.05, 0.0, c_luma);
        float hair_by_darkness = surround_screen * very_dark * has_screen_mix;

        // Basic hair detection (single-pixel, no neighbors - original method)
        float basic_hair = compute_hair_alpha(color);

        // Combined hair detection (max of all methods)
        float hair_detection = max(max(hair_by_contrast, hair_by_darkness), basic_hair);
        float hair_confidence = smoothstep(0.1, 0.5, hair_detection);

        // Final hair alpha: use screen subtraction for natural partial transparency
        // Screen subtraction gives physically accurate partial alpha for hair strands
        hair_alpha = screen_sub_alpha * hair_confidence;
    }

    // 3. Combine core + hair
    float alpha = max(core_alpha, hair_alpha * HairDetail);

    // 4. Edge blur (5x5 gaussian on alpha, unrolled)
    float blur_radius = EdgeBlur;
    float blurred_alpha = alpha;
    if (blur_radius > 0.01) {
        float2 ps = texel_size * blur_radius;
        float sum = 0.0;
        float wt = 0.0;
        float4 s;
        float w;
        float sa;

        // Row -2
        s = image.Sample(def_sampler, v_in.uv + float2(-2.0*ps.x, -2.0*ps.y)); sa = compute_core_alpha(s); w = 1.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2(-1.0*ps.x, -2.0*ps.y)); sa = compute_core_alpha(s); w = 4.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 0.0,      -2.0*ps.y)); sa = compute_core_alpha(s); w = 6.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 1.0*ps.x, -2.0*ps.y)); sa = compute_core_alpha(s); w = 4.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 2.0*ps.x, -2.0*ps.y)); sa = compute_core_alpha(s); w = 1.0; sum += sa*w; wt += w;

        // Row -1
        s = image.Sample(def_sampler, v_in.uv + float2(-2.0*ps.x, -1.0*ps.y)); sa = compute_core_alpha(s); w = 4.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2(-1.0*ps.x, -1.0*ps.y)); sa = compute_core_alpha(s); w = 16.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 0.0,      -1.0*ps.y)); sa = compute_core_alpha(s); w = 24.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 1.0*ps.x, -1.0*ps.y)); sa = compute_core_alpha(s); w = 16.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 2.0*ps.x, -1.0*ps.y)); sa = compute_core_alpha(s); w = 4.0; sum += sa*w; wt += w;

        // Row 0
        s = image.Sample(def_sampler, v_in.uv + float2(-2.0*ps.x, 0.0)); sa = compute_core_alpha(s); w = 6.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2(-1.0*ps.x, 0.0)); sa = compute_core_alpha(s); w = 24.0; sum += sa*w; wt += w;
        w = 36.0; sum += core_alpha*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 1.0*ps.x, 0.0)); sa = compute_core_alpha(s); w = 24.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 2.0*ps.x, 0.0)); sa = compute_core_alpha(s); w = 6.0; sum += sa*w; wt += w;

        // Row 1
        s = image.Sample(def_sampler, v_in.uv + float2(-2.0*ps.x, 1.0*ps.y)); sa = compute_core_alpha(s); w = 4.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2(-1.0*ps.x, 1.0*ps.y)); sa = compute_core_alpha(s); w = 16.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 0.0,       1.0*ps.y)); sa = compute_core_alpha(s); w = 24.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 1.0*ps.x, 1.0*ps.y)); sa = compute_core_alpha(s); w = 16.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 2.0*ps.x, 1.0*ps.y)); sa = compute_core_alpha(s); w = 4.0; sum += sa*w; wt += w;

        // Row 2
        s = image.Sample(def_sampler, v_in.uv + float2(-2.0*ps.x, 2.0*ps.y)); sa = compute_core_alpha(s); w = 1.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2(-1.0*ps.x, 2.0*ps.y)); sa = compute_core_alpha(s); w = 4.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 0.0,       2.0*ps.y)); sa = compute_core_alpha(s); w = 6.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 1.0*ps.x, 2.0*ps.y)); sa = compute_core_alpha(s); w = 4.0; sum += sa*w; wt += w;
        s = image.Sample(def_sampler, v_in.uv + float2( 2.0*ps.x, 2.0*ps.y)); sa = compute_core_alpha(s); w = 1.0; sum += sa*w; wt += w;

        blurred_alpha = sum / wt;
    }

    // Re-apply hair detail after blur (preserve thin strands that blur would smooth away)
    alpha = max(blurred_alpha, hair_alpha * HairDetail);

    // 5. Background noise removal
    alpha = smoothstep(min(BackgroundClean, 0.999), 1.0, alpha);

    // 6. Edge shrink / grow
    alpha = saturate((alpha - EdgeShrink) / max(1.0 - EdgeShrink, 0.001));
    alpha = saturate(alpha / max(1.0 - EdgeGrow, 0.001));

    // 7. Despill: dual method
    float screen_excess_basic = screen_difference(color.rgb);
    float screen_excess_avg;
    if (ScreenType == 1) {
        screen_excess_avg = color.b - (color.r + color.g) * 0.5;
    } else {
        screen_excess_avg = color.g - (color.r + color.b) * 0.5;
    }
    float edge_spill_mask = 1.0 - smoothstep(0.85, 1.0, alpha);
    float screen_excess = max(screen_excess_basic, screen_excess_avg * edge_spill_mask);

    if (screen_excess > 0.0) {
        float pixel_luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
        float light_factor = smoothstep(0.3, 0.7, pixel_luma);
        float despill_strength = lerp(DespillDark, DespillLight, light_factor) * SpillReduction;

        if (ScreenType == 1) {
            color.b -= screen_excess * despill_strength;
            color.r += screen_excess * despill_strength * 0.08;
            color.g += screen_excess * despill_strength * 0.12;
        } else {
            color.g -= screen_excess * despill_strength;
            color.r += screen_excess * despill_strength * 0.12;
            color.b += screen_excess * despill_strength * 0.08;
        }
    }
    color.rgb = max(color.rgb, float3(0.0, 0.0, 0.0));

    // 8. Hair color injection on edges
    float edge_factor = saturate(1.0 - abs(alpha * 2.0 - 1.0));
    float3 injected = HairColor.rgb * max(screen_excess_basic, 0.0) * ColorInjectStrength * edge_factor;
    color.rgb += injected;

    // 9. Gamma correction
    float safe_gamma = max(Gamma, 0.1);
    color.rgb = pow(max(color.rgb, float3(0.0001, 0.0001, 0.0001)), float3(1.0 / safe_gamma, 1.0 / safe_gamma, 1.0 / safe_gamma));

    // 10. Brightness and contrast
    color.rgb = (color.rgb - 0.5) * Contrast + 0.5 + Brightness;

    // 11. Temperature
    color.r += Temperature * 0.1;
    color.b -= Temperature * 0.1;

    // 12. Tint
    color.g += Tint * 0.1;

    // 13. Saturation
    float luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
    color.rgb = lerp(float3(luma, luma, luma), color.rgb, Saturation);

    color.rgb = saturate(color.rgb);

    // 14. Apply alpha with opacity
    color.a *= clamp(alpha, 0.0, 1.0) * Opacity;

    return color;
}

// Production path: adaptive chromaticity matte, structured hair recovery,
// edge-aware refinement, and screen-color decontamination.
float4 PSAdaptiveKey(VertData v_in) : TARGET {
    float4 color = image.Sample(def_sampler, v_in.uv);
    float core_alpha = compute_core_alpha(color);
    float alpha = core_alpha;
    float hair_alpha = 0.0;
    float min_neighbor_alpha = core_alpha;
    float max_neighbor_alpha = core_alpha;
    float gaussian_alpha = core_alpha * 4.0;
    float neighbor_alpha_sum = 0.0;
    float neighbor_luma_sum = 0.0;
    float3 neighbor_screen_sum = float3(0.0, 0.0, 0.0);
    float neighbor_screen_weight = 0.0;

    // A shared 3x3 neighborhood drives hair detection, edge-aware blur, and
    // true morphological shrink/grow. This is cheaper than the old 25-tap blur.
    if (HairDetail > 0.001 || EdgeBlur > 0.01 || EdgeShrink > 0.001 || EdgeGrow > 0.001) {
        float4 left = image.Sample(def_sampler, v_in.uv + float2(-1.0, 0.0) * texel_size);
        float4 right = image.Sample(def_sampler, v_in.uv + float2(1.0, 0.0) * texel_size);
        float4 up = image.Sample(def_sampler, v_in.uv + float2(0.0, -1.0) * texel_size);
        float4 down = image.Sample(def_sampler, v_in.uv + float2(0.0, 1.0) * texel_size);
        float4 top_left = image.Sample(def_sampler, v_in.uv + float2(-1.0, -1.0) * texel_size);
        float4 top_right = image.Sample(def_sampler, v_in.uv + float2(1.0, -1.0) * texel_size);
        float4 bottom_left = image.Sample(def_sampler, v_in.uv + float2(-1.0, 1.0) * texel_size);
        float4 bottom_right = image.Sample(def_sampler, v_in.uv + float2(1.0, 1.0) * texel_size);

        float a_left = compute_core_alpha(left);
        float a_right = compute_core_alpha(right);
        float a_up = compute_core_alpha(up);
        float a_down = compute_core_alpha(down);
        float a_top_left = compute_core_alpha(top_left);
        float a_top_right = compute_core_alpha(top_right);
        float a_bottom_left = compute_core_alpha(bottom_left);
        float a_bottom_right = compute_core_alpha(bottom_right);

        min_neighbor_alpha = min(min(min(min(a_left, a_right), min(a_up, a_down)),
                                     min(a_top_left, a_top_right)),
                                 min(a_bottom_left, a_bottom_right));
        min_neighbor_alpha = min(min_neighbor_alpha, core_alpha);
        max_neighbor_alpha = max(max(max(max(a_left, a_right), max(a_up, a_down)),
                                     max(a_top_left, a_top_right)),
                                 max(a_bottom_left, a_bottom_right));
        max_neighbor_alpha = max(max_neighbor_alpha, core_alpha);

        neighbor_alpha_sum = a_left + a_right + a_up + a_down + a_top_left + a_top_right +
                             a_bottom_left + a_bottom_right;
        neighbor_screen_sum = left.rgb * (1.0 - a_left) + right.rgb * (1.0 - a_right) +
                              up.rgb * (1.0 - a_up) + down.rgb * (1.0 - a_down) +
                              top_left.rgb * (1.0 - a_top_left) + top_right.rgb * (1.0 - a_top_right) +
                              bottom_left.rgb * (1.0 - a_bottom_left) +
                              bottom_right.rgb * (1.0 - a_bottom_right);
        neighbor_screen_weight = 8.0 - neighbor_alpha_sum;
        gaussian_alpha += (a_left + a_right + a_up + a_down) * 2.0;
        gaussian_alpha += a_top_left + a_top_right + a_bottom_left + a_bottom_right;
        gaussian_alpha *= 0.0625;

        neighbor_luma_sum = dot(left.rgb, float3(0.2126, 0.7152, 0.0722)) +
                            dot(right.rgb, float3(0.2126, 0.7152, 0.0722)) +
                            dot(up.rgb, float3(0.2126, 0.7152, 0.0722)) +
                            dot(down.rgb, float3(0.2126, 0.7152, 0.0722)) +
                            dot(top_left.rgb, float3(0.2126, 0.7152, 0.0722)) +
                            dot(top_right.rgb, float3(0.2126, 0.7152, 0.0722)) +
                            dot(bottom_left.rgb, float3(0.2126, 0.7152, 0.0722)) +
                            dot(bottom_right.rgb, float3(0.2126, 0.7152, 0.0722));

        if (HairDetail > 0.001) {
            // Screen subtraction estimates fractional coverage. Local structure
            // prevents broad screen shadows and sensor noise becoming fake hair.
            float pixel_difference = screen_difference(boost_sat(color.rgb, KeySatBoost));
            float key_difference = max(screen_difference(boost_sat(KeyColor.rgb, KeySatBoost)), 0.02);
            float screen_subtraction_alpha = 1.0 - saturate(pixel_difference / key_difference);
            float neighbor_alpha_average = neighbor_alpha_sum * 0.125;
            float surround_screen = saturate(1.0 - neighbor_alpha_average);
            float pixel_luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
            float local_luma_detail = abs(neighbor_luma_sum * 0.125 - pixel_luma);
            float local_matte_range = max_neighbor_alpha - min_neighbor_alpha;
            float detail_low = lerp(0.045, 0.012, HairSoftness);
            float detail_high = lerp(0.18, 0.075, HairSoftness);
            float structure = smoothstep(detail_low, detail_high,
                                         local_luma_detail + local_matte_range * 0.16 +
                                         chroma_distance_to_key(color.rgb) * 0.18);
            float hair_confidence = saturate(surround_screen * structure + local_matte_range * 0.45);
            hair_alpha = screen_subtraction_alpha * hair_confidence;
            alpha = max(alpha, hair_alpha * HairDetail);
        }

        float transition = saturate(1.0 - abs(alpha * 2.0 - 1.0));
        float blur_strength = saturate(EdgeBlur * 0.35) * transition;
        alpha = lerp(alpha, gaussian_alpha, blur_strength);

        // Morphology changes only the local boundary, not every subject pixel.
        alpha = lerp(alpha, min_neighbor_alpha, saturate(EdgeShrink));
        alpha = lerp(alpha, max_neighbor_alpha, saturate(EdgeGrow));
        alpha = max(alpha, hair_alpha * HairDetail);
    }

    // Suppress only low-level matte noise while preserving partial hair alpha.
    float clean_amount = saturate(BackgroundClean);
    float cleaned_alpha = smoothstep(clean_amount * 0.35, 1.0 - clean_amount * 0.15, alpha);
    alpha = saturate(lerp(alpha, cleaned_alpha, clean_amount));

    // Remove the estimated screen contribution from partial edge pixels. This
    // eliminates the colored fringe before the gentler channel despill below.
    float key_energy = max(dot(KeyColor.rgb, KeyColor.rgb), 0.001);
    float screen_scale = clamp(dot(color.rgb, KeyColor.rgb) / key_energy, 0.2, 2.5);
    float3 scaled_key = KeyColor.rgb * screen_scale;
    float3 sampled_screen = neighbor_screen_sum / max(neighbor_screen_weight, 0.001);
    float sampled_screen_confidence = smoothstep(2.0, 6.0, neighbor_screen_weight);
    float3 local_screen = lerp(scaled_key, sampled_screen, sampled_screen_confidence);
    float safe_alpha = max(alpha, 0.08);
    float3 unmixed_color = (color.rgb - local_screen * (1.0 - alpha)) / safe_alpha;
    unmixed_color = clamp(unmixed_color, float3(0.0, 0.0, 0.0), float3(1.25, 1.25, 1.25));
    float decontaminate_mask = smoothstep(0.03, 0.3, alpha) * (1.0 - smoothstep(0.82, 0.995, alpha));
    color.rgb = lerp(color.rgb, unmixed_color, saturate(decontaminate_mask * SpillReduction * 0.8));

    // Concentrate despill on fractional boundaries so intentional green/blue
    // foreground colors are preserved as far as a chroma-only key permits.
    float screen_excess_basic = screen_difference(color.rgb);
    float screen_excess_average;
    if (ScreenType == 1) {
        screen_excess_average = color.b - (color.r + color.g) * 0.5;
    } else {
        screen_excess_average = color.g - (color.r + color.b) * 0.5;
    }
    float edge_factor = saturate(1.0 - abs(alpha * 2.0 - 1.0));
    float spill_mask = saturate((1.0 - alpha) * 1.25 + edge_factor * 0.65);
    float screen_excess = max(screen_excess_basic, screen_excess_average * spill_mask);
    if (screen_excess > 0.0) {
        float pixel_luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
        float light_factor = smoothstep(0.25, 0.75, pixel_luma);
        float despill_strength = lerp(DespillDark, DespillLight, light_factor) * SpillReduction * spill_mask;
        if (ScreenType == 1) {
            color.b -= screen_excess * despill_strength;
            color.r += screen_excess * despill_strength * 0.08;
            color.g += screen_excess * despill_strength * 0.12;
        } else {
            color.g -= screen_excess * despill_strength;
            color.r += screen_excess * despill_strength * 0.12;
            color.b += screen_excess * despill_strength * 0.08;
        }
    }
    color.rgb = max(color.rgb, float3(0.0, 0.0, 0.0));
    color.rgb += HairColor.rgb * max(screen_excess_basic, 0.0) * ColorInjectStrength * edge_factor;

    float safe_gamma = max(Gamma, 0.1);
    color.rgb = pow(max(color.rgb, float3(0.0001, 0.0001, 0.0001)),
                    float3(1.0 / safe_gamma, 1.0 / safe_gamma, 1.0 / safe_gamma));
    color.rgb = (color.rgb - 0.5) * Contrast + 0.5 + Brightness;
    color.r += Temperature * 0.1;
    color.b -= Temperature * 0.1;
    color.g += Tint * 0.1;
    float luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
    color.rgb = saturate(lerp(float3(luma, luma, luma), color.rgb, Saturation));
    color.a *= alpha * Opacity;
    return color;
}

technique Draw {
    pass {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSAdaptiveKey(v_in);
    }
}
